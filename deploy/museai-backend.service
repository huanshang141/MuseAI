# MuseAI backend systemd unit
#
# Install:
#   sudo cp deploy/museai-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now museai-backend
#
# Adjust before installing:
#   - WorkingDirectory / EnvironmentFile: replace /home/ubuntu/MuseAI
#     with the actual checkout path on the server.
#   - Run `/home/ubuntu/.local/bin/uv sync --frozen` before installing or
#     restarting the unit so the checked-out revision has a complete `.venv`.
#   - WorkingDirectory must remain the repository root because Alembic and
#     the application load configuration relative to it.

[Unit]
Description=MuseAI FastAPI backend (uvicorn)
# Infrastructure (PostgreSQL/Redis/Elasticsearch) runs via docker compose;
# start after docker so dependencies have a chance to come up first.
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/MuseAI
# The app also loads repository-root .env itself (pydantic-settings), so this is a
# safety net for values referenced at process start. systemd parses this file
# strictly: values with spaces must be quoted, no `export` keyword.
EnvironmentFile=/home/ubuntu/MuseAI/.env
# Keep PostgreSQL schema in sync with the application before accepting traffic.
# Alembic is idempotent when no revisions are pending; if a migration fails,
# the app should not start against a mismatched schema.
ExecStartPre=/home/ubuntu/MuseAI/.venv/bin/alembic upgrade head
ExecStart=/home/ubuntu/MuseAI/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
# Give in-flight SSE streams a moment to finish on stop/restart.
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
